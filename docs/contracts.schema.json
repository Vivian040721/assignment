{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "paper_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "stage"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "claim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim"
        },
        "evidence_type": {
          "default": "author_claim",
          "enum": [
            "author_claim",
            "system_inference",
            "research_idea"
          ],
          "title": "Evidence Type",
          "type": "string"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "PageMapping": {
      "additionalProperties": false,
      "description": "One-based PDF page with offsets into the persisted Markdown text.",
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "start_char": {
          "default": 0,
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "default": 0,
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "PageMapping",
      "type": "object"
    },
    "Paper": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "abstract": {
          "default": "",
          "title": "Abstract",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv Id"
        },
        "arxiv_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv Version"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "source_records": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Source Records",
          "type": "array"
        },
        "paper_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Url"
        },
        "pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Url"
        },
        "pdf_urls": {
          "items": {
            "type": "string"
          },
          "title": "Pdf Urls",
          "type": "array"
        },
        "citation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Count"
        },
        "initial_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Score"
        },
        "final_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Score"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Reason"
        },
        "ranking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Reason"
        },
        "ranking_details": {
          "additionalProperties": true,
          "title": "Ranking Details",
          "type": "object"
        },
        "pdf_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Path"
        },
        "markdown_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Path"
        },
        "page_map": {
          "items": {
            "$ref": "#/$defs/PageMapping"
          },
          "title": "Page Map",
          "type": "array"
        },
        "fulltext_quality": {
          "additionalProperties": true,
          "title": "Fulltext Quality",
          "type": "object"
        },
        "status": {
          "default": "metadata_only",
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorInfo"
          },
          "title": "Errors",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "paper_id",
        "title"
      ],
      "title": "Paper",
      "type": "object"
    },
    "PaperReference": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "paper_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Url"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        }
      },
      "required": [
        "paper_id",
        "title"
      ],
      "title": "PaperReference",
      "type": "object"
    },
    "PaperSummary": {
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "summary_scope": {
          "default": "abstract_only",
          "enum": [
            "fulltext",
            "partial_fulltext",
            "abstract_only",
            "failed",
            "demo_fixture"
          ],
          "title": "Summary Scope",
          "type": "string"
        },
        "research_question": {
          "default": "",
          "title": "Research Question",
          "type": "string"
        },
        "core_idea": {
          "default": "",
          "title": "Core Idea",
          "type": "string"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "title": "Methods",
          "type": "array"
        },
        "experiments": {
          "items": {
            "type": "string"
          },
          "title": "Experiments",
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "relevance": {
          "default": "",
          "title": "Relevance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "author_claims": {
          "items": {
            "type": "string"
          },
          "title": "Author Claims",
          "type": "array"
        },
        "system_inferences": {
          "items": {
            "type": "string"
          },
          "title": "System Inferences",
          "type": "array"
        },
        "speculative_ideas": {
          "items": {
            "type": "string"
          },
          "title": "Speculative Ideas",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "summary_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Path"
        },
        "markdown": {
          "default": "",
          "title": "Markdown",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorInfo"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "paper_id"
      ],
      "title": "PaperSummary",
      "type": "object"
    },
    "ResearchReport": {
      "additionalProperties": false,
      "properties": {
        "idea": {
          "title": "Idea",
          "type": "string"
        },
        "overview": {
          "default": "",
          "title": "Overview",
          "type": "string"
        },
        "related_work": {
          "items": {
            "type": "string"
          },
          "title": "Related Work",
          "type": "array"
        },
        "comparison": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Comparison",
          "type": "array"
        },
        "researched_questions": {
          "items": {
            "type": "string"
          },
          "title": "Researched Questions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "research_directions": {
          "items": {
            "type": "string"
          },
          "title": "Research Directions",
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/PaperReference"
          },
          "title": "References",
          "type": "array"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "markdown": {
          "default": "",
          "title": "Markdown",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorInfo"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "idea"
      ],
      "title": "ResearchReport",
      "type": "object"
    },
    "StageTiming": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "request_count": {
          "default": 0,
          "minimum": 0,
          "title": "Request Count",
          "type": "integer"
        },
        "success_count": {
          "default": 0,
          "minimum": 0,
          "title": "Success Count",
          "type": "integer"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "duration_seconds"
      ],
      "title": "StageTiming",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "idea": {
      "title": "Idea",
      "type": "string"
    },
    "query": {
      "default": "",
      "title": "Query",
      "type": "string"
    },
    "queries": {
      "items": {
        "type": "string"
      },
      "title": "Queries",
      "type": "array"
    },
    "mode": {
      "default": "live",
      "enum": [
        "demo",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "execution_mode": {
      "default": "sequential",
      "enum": [
        "sequential",
        "concurrent"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "top_k": {
      "default": 5,
      "maximum": 100,
      "minimum": 1,
      "title": "Top K",
      "type": "integer"
    },
    "papers": {
      "items": {
        "$ref": "#/$defs/Paper"
      },
      "title": "Papers",
      "type": "array"
    },
    "selected_papers": {
      "items": {
        "$ref": "#/$defs/Paper"
      },
      "title": "Selected Papers",
      "type": "array"
    },
    "summaries": {
      "items": {
        "$ref": "#/$defs/PaperSummary"
      },
      "title": "Summaries",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Source Counts",
      "type": "object"
    },
    "timings": {
      "items": {
        "$ref": "#/$defs/StageTiming"
      },
      "title": "Timings",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ErrorInfo"
      },
      "title": "Errors",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "status": {
      "default": "pending",
      "title": "Status",
      "type": "string"
    },
    "output_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Dir"
    }
  },
  "required": [
    "idea"
  ],
  "title": "PipelineResult",
  "type": "object"
}
