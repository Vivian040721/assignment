# live: real paper sources + Chat Completions compatible model endpoint.
PAPER_AGENT_MODE=live
PAPER_AGENT_OUTPUT_DIR=data/runs
PAPER_AGENT_DATA_DIR=data
PAPER_AGENT_TOP_K=5
PAPER_AGENT_PROCESSING=serial
PAPER_AGENT_CONCURRENCY=3
PAPER_AGENT_SOURCE_LIMIT=20
PAPER_AGENT_CANDIDATE_LIMIT=15
PAPER_AGENT_MERGED_CANDIDATE_LIMIT=0
PAPER_AGENT_SELECTOR_INPUT_TOKEN_BUDGET=0
PAPER_AGENT_REPORT_INPUT_TOKEN_BUDGET=64000
PAPER_AGENT_MAX_FULLTEXT_ATTEMPTS=0
PAPER_AGENT_RANKER=keyword
PAPER_AGENT_SEARCH_CONCURRENCY=2
PAPER_AGENT_DOWNLOAD_CONCURRENCY=3
PAPER_AGENT_CONVERSION_CONCURRENCY=2
PAPER_AGENT_LLM_CONCURRENCY=2
PAPER_AGENT_CACHE_ENABLED=true
PAPER_AGENT_CACHE_MODE=read_write
PAPER_AGENT_SELECTOR_FALLBACK=error

# DeepSeek defaults: https://api.deepseek.com and deepseek-flash.
# Configure the key locally on the backend. Never put it in browser storage.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_THINKING_ENABLED=false

# Legacy generic settings remain supported. A nonblank LLM_* value overrides
# its DEEPSEEK_* counterpart; blank legacy values fall back to DeepSeek.
# BASE_URL is the provider's API root, without /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_STEPS=8
LLM_CHUNK_CHARS=12000
LLM_MAX_CHUNKS=12
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=0.5
LLM_MAX_BACKOFF=8
LLM_MAX_CALLS=100
LLM_MAX_TOTAL_TOKENS=200000
LLM_MAX_OUTPUT_TOKENS=4000
LLM_INPUT_TOKEN_BUDGET=24000

# Optional free OpenAlex API key; never commit the actual key.
OPENALEX_API_KEY=
HTTP_TIMEOUT_SECONDS=30
# Optional HTTP proxy for paper search/download only; use your own local proxy URL.
PAPER_AGENT_HTTP_PROXY=
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF=0.5
ARXIV_REQUEST_INTERVAL=3
PAPER_AGENT_MAX_PDF_BYTES=52428800
PAPER_AGENT_MAX_REDIRECTS=5
PAPER_AGENT_DOWNLOAD_TIMEOUT=180
PAPER_AGENT_DOWNLOAD_CANDIDATE_TIMEOUT=45
