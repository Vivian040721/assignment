# demo: real MCP transport + synthetic fixtures; no external network or model.
# live: real paper sources + Chat Completions compatible model endpoint.
PAPER_AGENT_MODE=demo
PAPER_AGENT_OUTPUT_DIR=outputs
PAPER_AGENT_PROCESSING=serial
PAPER_AGENT_CONCURRENCY=3
PAPER_AGENT_SOURCE_LIMIT=20
PAPER_AGENT_CANDIDATE_LIMIT=15
PAPER_AGENT_RANKER=keyword

# BASE_URL is the provider's API root, without /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_STEPS=8
LLM_CHUNK_CHARS=12000
LLM_MAX_CHUNKS=12

# Optional free OpenAlex API key; never commit the actual key.
OPENALEX_API_KEY=
HTTP_TIMEOUT_SECONDS=30
# Optional HTTP proxy for paper search/download only; use your own local proxy URL.
PAPER_AGENT_HTTP_PROXY=
